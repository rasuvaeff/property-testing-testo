{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // The adapter is thin glue with no equivalent mutants: every one of its
    // 158 mutants is killed, so the gate enforces exactly that. Dropping it
    // back to 90 would let a real escape through unnoticed.
    "minMsi": 100,
    "mutators": {
        "@default": true
    }
}
